{
  "mcpServers": {
    "terraform": {
      "command": ".bob/scripts/run-terraform-mcp.sh",
      "args": [],
      "disabled": false,
      "timeout": 30000
    },
    "bob-marketplace": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:39247/mcp",
      "headers": {
        "Bob-Marketplace-Token": "bob-marketplace-local"
      },
      "disabled": false,
      "alwaysAllow": [
        "search_assets",
        "get_asset",
        "list_installed",
        "list_favorites",
        "suggest_assets",
        "list_updates"
      ]
    }
  }
}
