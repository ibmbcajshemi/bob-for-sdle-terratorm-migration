# =============================================================================
# ibmcloud-infra — Terraform Environment Variables Template (.env.example)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Source the .env before running Terraform:
#   set -a && source .env && set +a
#
# FROM-SCRATCH WORKFLOW:
#   1. Run bootstrap/ to create the COS instance + state bucket
#   2. Create HMAC credentials on the state bucket's COS instance
#   3. Export the credentials as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   4. terraform init -backend-config="bucket=${TF_BACKEND_bucket}"
#   5. terraform plan && terraform apply
# =============================================================================

# ---------------------------------------------------------------------------
# IBM Cloud API Key (provided by your admin — the ONLY secret you need from them)
# ---------------------------------------------------------------------------
TF_VAR_ibmcloud_api_key="REPLACE_WITH_YOUR_IBM_CLOUD_API_KEY"

# ---------------------------------------------------------------------------
# COS Backend Credentials (IBM COS HMAC, NOT AWS IAM keys)
# ---------------------------------------------------------------------------
# NOTE: These env var names (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) are
# required by the Terraform S3 backend — which uses the AWS SDK internally.
# The VALUES are IBM Cloud Object Storage HMAC credentials (S3-compatible),
# NOT AWS IAM keys.
#
# After running bootstrap, create HMAC credentials:
#   ibmcloud resource service-key-create tfstate-hmac-dev Writer \
#     --instance-name ibmcloud-infra-tfstate-cos-dev \
#     --parameters '{"HMAC":true}'
# Then export the cos_hmac_keys.access_key_id and .secret_access_key:
#   export AWS_ACCESS_KEY_ID="your-cos-hmac-access-key-id"
#   export AWS_SECRET_ACCESS_KEY="your-cos-hmac-secret-access-key"
AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"

# ---------------------------------------------------------------------------
# COS State Bucket (output from bootstrap — copy here after running bootstrap)
# ---------------------------------------------------------------------------
TF_BACKEND_bucket="REPLACE_WITH_STATE_BUCKET_NAME_FROM_BOOTSTRAP"

# Backend HMAC keys (mapped from the COS HMAC credentials above)
TF_VAR_cos_access_key="${AWS_ACCESS_KEY_ID}"
TF_VAR_cos_secret_key="${AWS_SECRET_ACCESS_KEY}"

# S3-compatible endpoint for IBM Cloud Object Storage
TF_VAR_state_bucket_endpoint="https://s3.us.cloud-object-storage.appdomain.cloud"

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------
TF_VAR_project_name="ibmcloud-infra"
TF_VAR_environment="dev"
TF_VAR_region="us-south"
TF_VAR_resource_group_name="Default"

# ---------------------------------------------------------------------------
# Application COS Bucket
# ---------------------------------------------------------------------------
# Must be globally unique — update before first apply
TF_VAR_app_bucket_name="ibmcloud-infra-app-dev"
TF_VAR_app_storage_class="standard"
TF_VAR_enable_versioning="false"

# ---------------------------------------------------------------------------
# VPC Networking
# ---------------------------------------------------------------------------
TF_VAR_vpc_address_prefix="10.10.0.0/16"
TF_VAR_subnet_cidr="10.10.1.0/24"
TF_VAR_zone="us-south-1"

# ---------------------------------------------------------------------------
# VSI (Virtual Server Instance)
# ---------------------------------------------------------------------------
TF_VAR_vsi_image_name="ibm-redhat-8-8-minimal-amd64-3"
TF_VAR_vsi_profile="bx2-2x8"

# SSH public key — export before sourcing .env:
#   export SSH_PUBLIC_KEY="$(cat ~/.ssh/id_ed25519.pub)"
TF_VAR_ssh_public_key="${SSH_PUBLIC_KEY}"

# ---------------------------------------------------------------------------
# Code Engine Application
# ---------------------------------------------------------------------------
TF_VAR_ce_app_image="icr.io/codeengine/helloworld"
TF_VAR_ce_app_min_scale="0"
TF_VAR_ce_app_max_scale="3"
TF_VAR_ce_app_cpu="0.25"
TF_VAR_ce_app_memory="0.5G"
